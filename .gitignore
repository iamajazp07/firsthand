# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local newsletter subscriber store (dev fallback; never committed)
/data/subscribers.local.json
# local admin content-queue store (dev fallback; never committed)
/data/queue.local.json
# local social-post store (dev fallback; never committed)
/data/social.local.json
# generated editorial briefs (pre-draft scaffolding; never committed)
/data/briefs/
# news-signal dedup store (which feed GUIDs/links have been seen; never committed)
/data/news-seen.local.json
# in-progress article drafts fed to content:ingest (never committed)
/data/drafts/

# next.js
/.next/
# per-vertical local-preview build dirs (scripts/preview-all.sh)
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets (.env, .env.local, etc.)
.env*
# ...but keep the documented template
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# News tracker store — runtime state, rewritten by `npm run news:fetch`
# every 15 minutes. Committing it would mean a deploy per fetch; the
# production copy lives on a volume via NEWS_DATA_DIR.
/data/news/

# Which tracked announcements already have a draft (or were skipped, and why).
/data/news-written.local.json
