# ============================================================================
# Firsthand environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local / .env.
# The site builds and runs with NONE of these set (local JSON fallback mode).
# ============================================================================

# --- Site origin -------------------------------------------------------------
# Absolute production origin used for canonical URLs, sitemap, robots, RSS, and
# JSON-LD. Defaults to https://readfirsthand.com when unset. Set this in Vercel to
# your live origin (e.g. your *.vercel.app preview URL, then the real domain).
NEXT_PUBLIC_SITE_URL=                 # e.g. https://readfirsthand.com

# --- Supabase (data layer) ---------------------------------------------------
# When BOTH of these are set, src/lib/db.ts queries Supabase; otherwise it
# falls back to the seed JSON in src/data/.
NEXT_PUBLIC_SUPABASE_URL=            # e.g. https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # service-role key (server-only — never expose to the client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon/public key (for future client-side reads)

# --- Admin review queue (/admin) --------------------------------------------
# Password for the /admin content-review dashboard. The session cookie is an
# HMAC of this value (no external auth library). If UNSET: in development
# /admin is open with a visible "DEV MODE" banner; in production /admin is
# blocked entirely (403). Set a strong value before deploying.
ADMIN_PASSWORD=                      # e.g. a long random string

# --- Analytics ---------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=                  # GA4 measurement ID, e.g. G-XXXXXXXXXX (analytics disabled if unset)

# --- Social automation (step 9) ----------------------------------------------
# The whole pipeline runs WITHOUT any of these: `npm run social:generate` makes
# drafts, admin approves/schedules, and `npm run social:send` marks due posts
# `skipped_no_credentials` (never "failed") when no tokens exist. Add tokens (or
# a webhook) later to actually post. Nothing here is required to build/run.
#
# Webhook fallback (RECOMMENDED near-term path — Buffer / Zapier / Make style):
# if set, EVERY platform POSTs the full post JSON here instead of calling a
# platform API directly; a 2xx marks the post `sent`.
SOCIAL_WEBHOOK_URL=                   # e.g. https://hooks.zapier.com/hooks/catch/xx/ or a Make/Buffer endpoint
#
# X (Twitter) API v2 — POST /2/tweets:
X_API_BEARER_TOKEN=                   # OAuth 2.0 user-context bearer token
#
# Meta Graph API — Facebook Page feed + Instagram publish:
META_PAGE_ID=                         # numeric Facebook Page ID
META_PAGE_ACCESS_TOKEN=               # long-lived Page access token (server-only)
META_IG_USER_ID=                      # Instagram Business/Creator user ID (linked to the Page)
#
# LinkedIn Share API — POST /v2/ugcPosts as an organization:
LINKEDIN_ACCESS_TOKEN=                # OAuth 2.0 access token (w_organization_social scope)
LINKEDIN_ORG_URN=                     # e.g. urn:li:organization:12345678

# --- Affiliate networks (later steps) -----------------------------------------
CLICKBANK_AFFILIATE_ID=              # ClickBank nickname/affiliate ID
CLICKBANK_API_KEY=                   # ClickBank API key (server-only)
PERFORMCB_AFFILIATE_ID=              # PerformCB (Clickbooth) affiliate ID
PERFORMCB_API_KEY=                   # PerformCB API key (server-only)
